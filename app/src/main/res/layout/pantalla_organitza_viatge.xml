<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true"
    tools:context=".PantallaOrganitzaViatgeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="120dp">

        <TextView
            android:id="@+id/tvOrganitzaViatgeTitle"
            style="@style/AppTitlePrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/organitza_viatge_titulo" />

        <TextView
            android:id="@+id/tvOrganitzaViatgeSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/organitza_viatge_subtitol_nou"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvLabelPais"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/camp_pais"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPais"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:hint="@string/hint_pais"
            android:inputType="textCapWords"
            android:minHeight="56dp"
            android:padding="16dp" />

        <TextView
            android:id="@+id/tvLabelDuracio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/camp_duracio"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDuracio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:hint="@string/hint_duracio_nou"
            android:inputType="number"
            android:minHeight="56dp"
            android:padding="16dp" />

        <TextView
            android:id="@+id/tvLabelPersones"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/camp_persones"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPersones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:hint="@string/hint_persones_nou"
            android:inputType="number"
            android:minHeight="56dp"
            android:padding="16dp" />

        <TextView
            android:id="@+id/tvLabelPressupost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/camp_pressupost"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPressupost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:hint="@string/hint_pressupost_nou"
            android:inputType="numberDecimal"
            android:minHeight="56dp"
            android:padding="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvLlistesTitle"
                style="@style/AppTitleSection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/seccio_llistes_titol" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCrearLlista"
                style="@style/AppPrimaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:paddingHorizontal="18dp"
                android:text="@string/boto_afegir_curt" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/seccio_llistes_subtitol_nou"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvEmptyLlistes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@android:color/transparent"
            android:paddingVertical="12dp"
            android:text="@string/llistes_buides"
            android:textSize="15sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLlistesViatge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_llista_viatge" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvReservesTitle"
                style="@style/AppTitleSection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/seccio_reserves_titol" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCrearReserva"
                style="@style/AppPrimaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:paddingHorizontal="18dp"
                android:text="@string/boto_afegir_curt" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEmptyReserves"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@android:color/transparent"
            android:paddingVertical="12dp"
            android:text="@string/reserves_buides"
            android:textSize="15sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvReservesViatge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false"
            tools:itemCount="1"
            tools:listitem="@layout/item_reserva_viatge" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvGastosTitle"
                style="@style/AppTitleSection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/seccio_gastos_titol" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCrearGasto"
                style="@style/AppPrimaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:paddingHorizontal="18dp"
                android:text="@string/boto_afegir_curt" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEmptyGastos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@android:color/transparent"
            android:paddingVertical="12dp"
            android:text="@string/gastos_buits"
            android:textSize="15sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGastosViatge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_gasto_viatge" />

        <TextView
            android:id="@+id/tvResumPressupostGastos"
            style="@style/AppTitleSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/resum_pressupost_gastos_base" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvLlocsTitle"
                style="@style/AppTitleSection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/seccio_llocs_titol" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCrearLloc"
                style="@style/AppPrimaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:paddingHorizontal="18dp"
                android:text="@string/boto_afegir_curt" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEmptyLlocs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@android:color/transparent"
            android:paddingVertical="12dp"
            android:text="@string/llocs_buits"
            android:textSize="15sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLlocsViatge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_lloc_viatge" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAlbumTitle"
                style="@style/AppTitleSection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/seccio_album_titol" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAfegirFotoAlbum"
                style="@style/AppPrimaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:paddingHorizontal="18dp"
                android:text="@string/boto_afegir_curt" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEmptyAlbum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@android:color/transparent"
            android:paddingVertical="12dp"
            android:text="@string/album_buit"
            android:textSize="15sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAlbumFotos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_album_foto_editable" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarViatge"
            style="@style/AppPrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:paddingVertical="14dp"
            android:text="@string/boto_guardar_viatge_nou" />

    </LinearLayout>

</ScrollView>
