<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true"
    tools:context=".CountryDetailFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="90dp">

        <TextView
            android:id="@+id/tvCountryTitle"
            style="@style/AppTitlePrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Espanya" />

        <TextView
            android:id="@+id/tvCountrySubtitle"
            style="@style/AppTitleSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            tools:text="Una destinació vibrant per descobrir." />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/nav_blue"
            app:strokeWidth="1dp">

            <ViewFlipper
                android:id="@+id/vfCountryPhotos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoStart="true"
                android:flipInterval="3000"
                android:inAnimation="@android:anim/fade_in"
                android:outAnimation="@android:anim/fade_out" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_section_nav_blue_rounded"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/AppTitleSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/country_general_data_title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/country_capital_label"
                android:textColor="@color/black"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCountryCapitalValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_camp_detall_viatge"
                android:padding="12dp"
                tools:text="Madrid" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/country_population_label"
                android:textColor="@color/black"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCountryPopulationValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_camp_detall_viatge"
                android:padding="12dp"
                tools:text="48 milions (aprox.)" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/country_religion_label"
                android:textColor="@color/black"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCountryReligionValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_camp_detall_viatge"
                android:padding="12dp"
                tools:text="Cristianisme (majoritari)" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_section_nav_blue_rounded"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/AppTitleSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/country_places_title" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCountryPlaces"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_lloc_turistic" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackCountryDetail"
            style="@style/AppPrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/country_back_button" />

    </LinearLayout>

</ScrollView>
