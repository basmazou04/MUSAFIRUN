<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:background="@color/top_bar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingStart="18dp"
        android:paddingEnd="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MUSAFIRUN"
            android:textAllCaps="true"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/title_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnTopProfile"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@string/ajustes_perfil_titol"
            android:src="@drawable/ajustes"
            app:tint="@color/icon_on_primary" />
    </LinearLayout>

    <!-- Contenedor de fragments -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toTopOf="@id/nav_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvHomeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pantalla_principal_titol"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center"/>

    </FrameLayout>

    <!-- NAVBAR FLOTANTE -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/nav_container"
        android:layout_width="0dp"
        android:layout_height="74dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        app:cardCornerRadius="40dp"
        app:cardElevation="12dp"

        app:cardBackgroundColor="@color/nav_bar_bg"
        app:strokeWidth="1dp"
        app:strokeColor="@color/nav_bar_stroke">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <!-- ITEM NAV -->

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <!-- Indicador activo -->

                <View
                    android:id="@+id/crystal_indicator_home"
                    android:layout_width="52dp"
                    android:layout_height="54dp"
                    android:layout_gravity="center"
                    android:background="@drawable/orb_glow"
                    android:visibility="visible" />

                <ImageView
                    android:id="@+id/nav_home"
                    android:layout_width="70dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:src="@drawable/main"
                    app:tint="@color/icon_on_primary" />
            </FrameLayout>

            <!-- SEARCH -->

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <View
                    android:id="@+id/crystal_indicator_search"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="center"
                    android:background="@drawable/orb_glow"
                    android:visibility="gone"/>

                <ImageView
                    android:id="@+id/nav_search"
                    android:layout_width="71dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:src="@drawable/orden"
                    app:tint="@color/icon_on_primary_muted" />

            </FrameLayout>

            <!-- ADD -->

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <View
                    android:id="@+id/crystal_indicator_add"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="center"
                    android:background="@drawable/orb_glow"
                    android:visibility="gone"/>

                <ImageView
                    android:id="@+id/nav_add"
                    android:layout_width="81dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:src="@drawable/buscador"
                    app:tint="@color/icon_on_primary_muted" />


            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <View
                    android:id="@+id/crystal_indicator_fav"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="center"
                    android:background="@drawable/orb_glow"
                    android:visibility="gone"/>

                <ImageView
                    android:id="@+id/nav_fav"
                    android:layout_width="84dp"
                    android:layout_height="87dp"
                    android:layout_gravity="center"
                    android:src="@drawable/minijuegos"
                    app:tint="@color/icon_on_primary_muted" />

            </FrameLayout>

            <!-- SAVED / SHARED -->

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <View
                    android:id="@+id/crystal_indicator_saved"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="center"
                    android:background="@drawable/orb_glow"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/nav_saved"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/nav_guardades_titol"
                    android:src="@drawable/ic_bookmark"
                    app:tint="@color/icon_on_primary_muted" />

            </FrameLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
