    <string name="country_place_belgica_2_title">Bruges</string>
    <string name="country_place_belgica_2_desc">Highly recommended for its canals, medieval center and romantic atmosphere.</string>
    <string name="country_place_belgica_3_title">Gant</string>
    <string name="country_place_belgica_3_desc">It combines historical heritage with a very attractive young and cultural atmosphere.</string>
    <string name="country_subtitle_marroc">Color, traditional markets and surprising passages.</string>
    <string name="country_population_marroc">38 million inhabitants (approx.)</string>
    <string name="country_religion_marroc">Islam (majority)</string>
    <string name="country_caption_marroc_1">Medinas and souks</string>
    <string name="country_caption_marroc_2">Desert and nature</string>
    <string name="country_caption_marroc_3">Traditional culture</string>
    <string name="country_place_marroc_1_title">Marrakech</string>
    <string name="country_place_marroc_1_desc">Ideal for experiencing the atmosphere of markets, palaces and squares full of activity.</string>
    <string name="country_place_marroc_2_desc">Its historic medina is one of the most authentic and fascinating in the country.</string>
    <string name="country_place_marroc_3_desc">It stands out for its blue streets and a quiet atmosphere perfect for strolling.</string>
    <string name="country_subtitle_turquia">Bridge between Europe and Asia with a thousand-year history.</string>
    <string name="country_population_turquia">86 million inhabitants (approx.)</string>
    <string name="country_religion_turquia">Islam (majority)</string>
    <string name="country_caption_turquia_1">Mosques and heritage</string>
    <string name="country_caption_turquia_2">Markets and local culture</string>
    <string name="country_caption_turquia_3">Ancient natural landscapes</string>
    <string name="country_place_turquia_1_desc">Perfect for its imperial history, bazaars and emblematic monuments.</string>
    <string name="country_place_turquia_2_title">Capadocia</string>
    <string name="country_place_turquia_2_desc">An unforgettable visit through volcanic passages and balloon flights.</string>
    <string name="country_place_turquia_3_desc">Very good option to combine beaches, old town and ancient ruins.</string>
